# Aplicacion
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1

# MySQL - valores locales de ejemplo, no son credenciales reales
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cine_arte
MYSQL_USER=cine_arte_app
MYSQL_PASSWORD=replace_with_local_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_CONNECTION_LIMIT=10

# Integraciones externas
TMDB_API_TOKEN=replace_with_your_tmdb_read_access_token
SCRAPER_USER_AGENT=CineArtePlatform/0.1 (contact@example.com)
SCRAPER_REQUEST_TIMEOUT_MS=10000
