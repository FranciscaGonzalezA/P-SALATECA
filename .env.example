# Aplicacion
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=/api/v1

# MySQL - valores locales de ejemplo, no son credenciales reales
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cine_arte
MYSQL_USER=cine_arte_app
MYSQL_PASSWORD=replace_with_local_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_CONNECTION_LIMIT=10
MYSQL_QUEUE_LIMIT=50
REQUEST_TIMEOUT_MS=15000
RATE_LIMIT_MAX=120

# Integraciones externas
TMDB_READ_ACCESS_TOKEN=replace_with_your_tmdb_read_access_token
TMDB_LANGUAGE=es-CL
TMDB_REQUEST_TIMEOUT_MS=10000
SESSION_DURATION_HOURS=8
PASSWORD_RESET_TOKEN_MINUTES=30
# Opcionales; configurar ambos para habilitar la cuenta administradora
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=replace_with_at_least_12_characters
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=
