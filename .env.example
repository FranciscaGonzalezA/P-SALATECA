# Aplicacion
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
VITE_DEMO_MODE=true
SESSION_DURATION_HOURS=8

# Puertos publicados por Docker; son distintos de los servicios locales para evitar conflictos.
DOCKER_MYSQL_PORT=3307
DOCKER_BACKEND_PORT=3001
DOCKER_FRONTEND_PORT=5174

# Administrador inicial. Cambia estos valores antes de ejecutar el backend.
ADMIN_EMAIL=admin@salateca.cl
ADMIN_PASSWORD=replace_with_a_password_of_at_least_12_characters

# MySQL - valores locales de ejemplo, no son credenciales reales
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cine_arte
MYSQL_USER=cine_arte_app
MYSQL_PASSWORD=replace_with_local_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_CONNECTION_LIMIT=10

# Integraciones externas. Configura al menos una credencial de TMDB; se prefiere el token de lectura.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_LANGUAGE=es-CL
TMDB_REQUEST_TIMEOUT_MS=10000
SCRAPER_USER_AGENT=CineArtePlatform/0.1 (contact@example.com)
SCRAPER_REQUEST_TIMEOUT_MS=10000
