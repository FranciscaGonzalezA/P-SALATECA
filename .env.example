# Aplicacion
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=5173
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
VITE_DEMO_MODE=true
SESSION_DURATION_HOURS=8

# Puertos publicados por Docker; son distintos de los servicios locales para evitar conflictos.
DOCKER_MYSQL_PORT=3308
DOCKER_BACKEND_PORT=3001
DOCKER_FRONTEND_PORT=5174

# Administrador inicial. Cambia estos valores antes de ejecutar el backend.
ADMIN_EMAIL=admin@salateca.cl
ADMIN_PASSWORD=replace_with_a_password_of_at_least_12_characters

# MySQL - valores locales de ejemplo, no son credenciales reales
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cine_arte
MYSQL_USER=cine_arte_app
MYSQL_PASSWORD=replace_with_local_password
MYSQL_ROOT_PASSWORD=replace_with_local_root_password
MYSQL_CONNECTION_LIMIT=10

# Integraciones externas. Configura al menos una credencial de TMDB; se prefiere el token de lectura.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
TMDB_LANGUAGE=es-CL
TMDB_REQUEST_TIMEOUT_MS=10000
SCRAPER_USER_AGENT=CineArtePlatform/0.1 (contact@example.com)
SCRAPER_REQUEST_TIMEOUT_MS=10000
SCRAPER_REQUEST_RETRIES=2

# Ingesta automática. Usa el mismo secreto aleatorio (mínimo 32 caracteres) en backend y scraper.
# Mientras el valor comience con replace_with_, el endpoint permanece deshabilitado.
SCRAPER_INGEST_TOKEN=replace_with_a_random_scraper_token_of_at_least_32_characters
SCRAPER_BACKEND_URL=http://localhost:3000/api/v1
SCRAPER_MIN_SUCCESSFUL_SOURCES=3
SCRAPER_MIN_ACCEPTED_RECORDS=1

# Programación semanal: miércoles a las 09:00, hora de Santiago.
SCRAPER_SCHEDULE_DAY=wednesday
SCRAPER_SCHEDULE_TIME=09:00
SCRAPER_SCHEDULE_TIMEZONE=America/Santiago
SCRAPER_RUN_ON_START=false

# Nexo Cinema usa la API oficial de Instagram. Sin token, el conector queda deshabilitado.
NEXO_INSTAGRAM_ACCESS_TOKEN=
